# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

# Task 4 must supply a reviewed Linux AMD64 Python 3.11 CUDA/PyTorch image by digest.
# Example shape: --build-arg GPU_BASE_IMAGE=repository/image:tag@sha256:<digest>
ARG GPU_BASE_IMAGE

FROM ${GPU_BASE_IMAGE} AS builder

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    SAM2_BUILD_CUDA=0

WORKDIR /app
COPY requirements-gpu.lock ./
RUN uv venv --python python /app/.venv \
    && uv pip sync --python /app/.venv/bin/python --require-hashes \
        --torch-backend cu121 requirements-gpu.lock

# Ultralytics appends its own /Ultralytics directory to YOLO_CONFIG_DIR, so
# this must name the writable parent mounted by the read-only runtime checks.
FROM ${GPU_BASE_IMAGE} AS runtime

ENV HOME=/home/watermark-worker \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp/watermark-worker \
    WM_MODEL_WORK_ROOT=/tmp/watermark-worker/models \
    HF_HOME=/tmp/watermark-worker/huggingface \
    TRANSFORMERS_CACHE=/tmp/watermark-worker/huggingface/transformers \
    HUGGINGFACE_HUB_CACHE=/tmp/watermark-worker/huggingface/hub \
    XDG_CACHE_HOME=/tmp/watermark-worker/cache \
    YOLO_CONFIG_DIR=/tmp/watermark-worker \
    SAM2_BUILD_CUDA=0

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 watermark-worker \
    && useradd --uid 10001 --gid 10001 --create-home \
        --home-dir /home/watermark-worker watermark-worker \
    && mkdir -p /tmp/watermark-worker/models \
    && chown -R 10001:10001 /tmp/watermark-worker

WORKDIR /app
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 src ./src
COPY --chown=10001:10001 configs ./configs
COPY --chown=10001:10001 model-manifest.json ./model-manifest.json

USER 10001:10001
ENTRYPOINT ["python", "-m", "watermark_worker"]
