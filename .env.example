PROJECT_NAME=infringement-pipeline-backend
ENV=development

# Generate via app.core.security.generate_secret_key()
SECRET_KEY=change-me
# Auth token settings. In staging/production, SECRET_KEY must be changed.
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
REFRESH_TOKEN_COOKIE_NAME=refresh_token
# Local HTTP development can use false; production HTTPS should use true.
REFRESH_TOKEN_COOKIE_SECURE=false
# Use none + secure=true when the frontend/backend are cross-site and cookies
# must be sent on refresh/logout requests.
REFRESH_TOKEN_COOKIE_SAMESITE=lax

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infringement
# SQLAlchemy connection pool sizing, applied PER PROCESS. These are the baseline
# for the API and the sync job. The real connection total across the
# deployment is (pool_size + max_overflow) * number_of_processes, so keep these
# small and check them against Postgres max_connections.
DB_POOL_SIZE=6
DB_MAX_OVERFLOW=10
# The bulk scan job runs nested product/image concurrency and needs a bigger
# pool. Set DB_POOL_PROFILE=bulk_scan on that process ONLY (see the Cloud Run
# bulk scan job) to switch it to the values below;
# every other process keeps the small baseline pool above.
DB_POOL_PROFILE=default
BULK_SCAN_DB_POOL_SIZE=24
BULK_SCAN_DB_MAX_OVERFLOW=10
# Cloud Run only: set this to project:region:instance to connect through
# /cloudsql instead of POSTGRES_HOST public IP.
CLOUD_SQL_CONNECTION_NAME=

# Optional: needed for Gemini text context and image logo fallback.
# Authentication should use Google Cloud ADC, for example via
# GOOGLE_APPLICATION_CREDENTIALS or workload identity.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Cloud Run Jobs dispatch target. Set these on the API service so dispatch does
# not accidentally reuse a generic Google location such as "global".
CLOUD_RUN_JOBS_PROJECT=
CLOUD_RUN_JOBS_LOCATION=us-central1
LLM_PROTECTED_TERM_MODEL=gemini-3.1-flash-lite

# Max local image upload size for /api/v1/detection/image/file.
IMAGE_OCR_MAX_FILE_BYTES=10485760
# Image text OCR provider. Use google_vision to restore the previous OCR path.
IMAGE_OCR_PROVIDER=google_vision
# These limits apply per process. Keep concurrency at 1 unless a representative
# Cloud Run benchmark proves that multiple Paddle clients are safe and faster.
IMAGE_OCR_PADDLE_MAX_CONCURRENCY=1
IMAGE_OCR_PADDLE_CPU_THREADS=2

# Minimum Google Vision logo confidence required to create an image_logo risk match.
IMAGE_LOGO_MIN_SCORE=0.70

# Shopify app OAuth/configuration.
SHOPIFY_APP_URL=
SHOPIFY_REDIRECT_URI=
SHOPIFY_SCOPES=read_products,read_online_store_navigation
SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_AUTOMATION_TOKEN=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Bulk scan concurrency. Max in-flight image pipelines for one bulk job =
# product concurrency * image concurrency. Product
# concurrency defaults to 1 (serial); the tuned target after staging is 3, set
# on the bulk scan job together with DB_POOL_PROFILE=bulk_scan.
SHOPIFY_BULK_SCAN_PRODUCT_CONCURRENCY=1
# Max media images one product scans concurrently. Raise it together with the
# bulk scan DB pool and job memory. Deployed value is 5.
SHOPIFY_BULK_SCAN_IMAGE_CONCURRENCY=5
# Shopify product sync downloads the completed bulk export as a streamed JSONL
# file. Keep the read timeout high enough for large catalogs and use small
# retries for transient Shopify/GCS connection failures before streaming starts.
SHOPIFY_BULK_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
SHOPIFY_BULK_DOWNLOAD_READ_TIMEOUT_SECONDS=450
SHOPIFY_BULK_DOWNLOAD_RETRY_ATTEMPTS=3
SHOPIFY_BULK_DOWNLOAD_RETRY_BACKOFF_SECONDS=5

# Used by Dockerfile prod stage (gunicorn)
WORKERS=2
