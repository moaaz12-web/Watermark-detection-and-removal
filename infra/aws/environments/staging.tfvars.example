environment        = "staging"
aws_region         = "eu-north-1"
aws_account_id     = "154959837939"
gcp_project_id     = "project-5909a738-2fdc-451e-ad6"
gcp_project_number = "834057675927"

google_jwt_issuer      = "https://accounts.google.com"
google_jwt_audience    = "urn:watermark:aws-gpu-submission:staging"

approved_manifest_prefixes = [
  "gs://OWNER_SUPPLIED_MANIFEST_BUCKET/OWNER_SUPPLIED_PREFIX/",
]
approved_output_prefixes = [
  "gs://OWNER_SUPPLIED_OUTPUT_BUCKET/OWNER_SUPPLIED_PREFIX/",
]

pipeline_allowlist = ["watermark-v1"]
submission_enabled = false
batch_queue_enabled = false

# Leave empty until the A5 push finishes and ECR reports the immutable digest.
worker_image_digest = ""

gcs_worker_read_prefixes = [
  {
    bucket = "OWNER_SUPPLIED_DATA_BUCKET"
    prefix = "OWNER_SUPPLIED_INPUT_PREFIX/"
  },
  {
    bucket = "OWNER_SUPPLIED_MODEL_BUCKET"
    prefix = "watermark-v1/"
  },
]

gcs_worker_output_prefixes = [
  {
    bucket = "OWNER_SUPPLIED_DATA_BUCKET"
    prefix = "OWNER_SUPPLIED_OUTPUT_PREFIX/"
  },
]
